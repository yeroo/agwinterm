<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>
  <!-- The shipped ConPTY in the layout the app gets (conpty.dll, x64/OpenConsole.exe), for the #339 tests. -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)/runtimes/win-x64/native/conpty.dll" Link="conpty/conpty.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)/build/native/runtimes/x64/OpenConsole.exe" Link="conpty/x64/OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Agwinterm.Pty/Agwinterm.Pty.csproj" />
    <!-- agwintermctl arg parsing (FrameShmCli) is unit-tested here; the exe reference is harmless. -->
    <ProjectReference Include="../../src/Agwinterm.Ctl/Agwinterm.Ctl.csproj" />
  </ItemGroup>
</Project>
